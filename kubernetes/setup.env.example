# --- Banco de dados ---
MYSQL_ROOT_PASSWORD=troque-esta-senha

# --- AWS Cognito ---
COGNITO_USER_POOL_ID=us-east-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Credenciais AWS (boto3 / chamadas ao Cognito) ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-2

# --- Chaves de APIs externas ---
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=

# --- Chaves RSA ---
# Se vazios, o script gera um par novo automaticamente.
RSA_PRIVATE_KEY_PATH=
RSA_PUBLIC_KEY_PATH=

# --- Criptografia at-rest ---
GENERATE_ENCRYPTION_KEY=true
